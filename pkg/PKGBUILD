# Maintainer: tongtf
pkgname=kgx-compact
pkgver=1.0.0
pkgrel=1
pkgdesc="Borderless GNOME Console (kgx) with a compact tab strip, via a GResource overlay"
arch=('any')
url="https://github.com/tongtf/kgx-compact"
license=('MIT')
depends=('gnome-console' 'python3' 'gtk4' 'libadwaita')
optdepends=(
  "gnome-shell: set the default terminal from GNOME Settings"
)
makedepends=()
source=("$pkgname-$pkgver.tar.gz")
# The tarball is generated from git HEAD by pkg/build-release.sh, so its checksum is
# different for every commit and cannot be pinned in the repo. SKIP is the honest
# value here; this package is not distributed by a repository.
sha256sums=('SKIP')

# This package ships no compiled code and installs only into the invoking user's home,
# because the whole mechanism is G_RESOURCE_OVERLAYS plus a GTK4 user stylesheet - both
# of which are per-user by design. A system package could not do this correctly.
#
# Because there is nothing to build, skip the normal build phases and install in postinst.

build() {
    cd "$srcdir/$pkgname-$pkgver"
    # Nothing to compile. The syntax check is the one real build step, and it is worth
    # having: a broken install.sh should fail the build, not a user's terminal.
    bash -n install.sh
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    # tests/run.sh skips the parts it cannot do (no kgx binary, no display) rather than
    # failing, so this is safe inside a build chroot that has neither.
    ./tests/run.sh
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 install.sh            "$pkgdir/usr/bin/kgx-compact-install"
    install -Dm644 LICENSE               "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # Listed explicitly rather than globbed, so this recipe and
    # debian/kgx-compact.install can be diffed against each other. tests/run.sh fails
    # the build if the two ever install a different set of tools.
    for doc in README.md CONTRIBUTING.md SECURITY.md docs/CSS.md docs/UPGRADING.md; do
        install -Dm644 "$doc"            "$pkgdir/usr/share/doc/$pkgname/${doc##*/}"
    done
    for f in src/kgx-compact src/gtk.css overlay/compact-tab-bar.ui.xml \
             tools/kgx-patch.py tools/kgx-verify.py tools/check-overlay.py \
             tools/check-css.py tools/verify-css-match.py; do
        install -Dm755 "$f"              "$pkgdir/usr/share/$pkgname/${f##*/}"
    done
}

# Deliberately do NOT enable the package. The overlay is per-user and version-pinned to
# the Console the user actually has, so enabling it globally would be wrong. The user
# runs `kgx-compact-install` for their own account and then follows the printed
# gsettings command.