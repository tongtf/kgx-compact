#!/usr/bin/make -f
# kgx-compact is scripts and data only: nothing to compile, so no build system and
# dh will do. The per-user installer is deliberately NOT run at package install time -
# see debian/control and README.md.

%:
	dh $@

override_dh_auto_test:
	# Worth running because it verifies the debian recipe itself (version agreement
	# with the PKGBUILD, both installing the same set of tools). Most other checks skip
	# here and say why: there is no Console to extract templates from at build time,
	# and no display. The full suite runs in CI, where both exist.
	./tests/run.sh